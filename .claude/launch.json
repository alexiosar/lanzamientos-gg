{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "scripts/servidor-local.py",
        "8080"
      ],
      "port": 8080
    },
    {
      "name": "worker",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "wrangler@4",
        "dev",
        "--port",
        "8787",
        "--local"
      ],
      "port": 8787
    }
  ]
}
